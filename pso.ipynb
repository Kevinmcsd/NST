```python id="ckcwy2"
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import f1_score

np.random.seed(42)

signal_length = 1200

baseline = 140

signal = baseline + np.random.normal(0, 1, signal_length)

ground_truth = np.zeros(signal_length)

real_peaks = [
    (100, 120, 18),
    (300, 320, 20),
    (700, 720, 17)
]

for start, end, amp in real_peaks:
    signal[start:end] += amp
    ground_truth[start:end] = 1

def detect_peaks(signal, baseline, amp_shift, time_shift):

    detected = np.zeros(len(signal))

    threshold = baseline + amp_shift

    in_peak = False

    for i in range(len(signal)):

        if signal[i] >= threshold and not in_peak:
            start = i
            in_peak = True

        elif signal[i] < threshold and in_peak:

            end = i

            if end - start >= time_shift:
                detected[start:end] = 1

            in_peak = False

    return detected

num_particles = 20
max_iter = 40

w = 0.7
c1 = 1.5
c2 = 1.5

particles = np.random.uniform(
    low=[5,5],
    high=[30,40],
    size=(num_particles,2)
)

velocities = np.zeros((num_particles,2))

pbest = particles.copy()
pbest_scores = np.zeros(num_particles)

gbest = None
gbest_score = -1

history = []

for i in range(num_particles):

    amp_shift = int(particles[i][0])
    time_shift = int(particles[i][1])

    pred = detect_peaks(
        signal,
        baseline,
        amp_shift,
        time_shift
    )

    score = f1_score(ground_truth, pred)

    pbest_scores[i] = score

    if score > gbest_score:
        gbest_score = score
        gbest = particles[i].copy()

for iteration in range(max_iter):

    for i in range(num_particles):

        r1 = np.random.rand(2)
        r2 = np.random.rand(2)

        velocities[i] = (
            w * velocities[i]
            + c1 * r1 * (pbest[i] - particles[i])
            + c2 * r2 * (gbest - particles[i])
        )

        particles[i] += velocities[i]

        particles[i][0] = np.clip(particles[i][0], 5, 30)
        particles[i][1] = np.clip(particles[i][1], 5, 40)

        amp_shift = int(particles[i][0])
        time_shift = int(particles[i][1])

        pred = detect_peaks(
            signal,
            baseline,
            amp_shift,
            time_shift
        )

        score = f1_score(ground_truth, pred)

        if score > pbest_scores[i]:
            pbest_scores[i] = score
            pbest[i] = particles[i].copy()

        if score > gbest_score:
            gbest_score = score
            gbest = particles[i].copy()

    history.append(gbest_score)

best_amp = int(gbest[0])
best_time = int(gbest[1])

final_prediction = detect_peaks(
    signal,
    baseline,
    best_amp,
    best_time
)

print("\nBest Parameters Found:\n")

print(f"Amplitude Shift = {best_amp}")
print(f"Time Shift = {best_time}")

print(f"\nMaximum F1-Score = {gbest_score:.4f}")

plt.figure(figsize=(15,6))

plt.plot(signal, label='FHR Signal')

plt.axhline(
    baseline + best_amp,
    color='red',
    linestyle='--',
    label='Optimized Threshold'
)

detected_idx = np.where(final_prediction == 1)[0]

plt.scatter(
    detected_idx,
    signal[detected_idx],
    s=10,
    label='Detected Peaks'
)

plt.title('Fetal Heart Rate Peak Detection using PSO')

plt.xlabel('Time')

plt.ylabel('FHR')

plt.legend()

plt.grid(True)

plt.show()

plt.figure(figsize=(10,5))

plt.plot(history)

plt.title('PSO Optimization Process')

plt.xlabel('Iteration')

plt.ylabel('Best F1-Score')

plt.grid(True)

plt.show()
```
