import numpy as np
import matplotlib.pyplot as plt

fs = 1
duration = 600

t = np.arange(0, duration)

baseline = 140

fhr = baseline + np.random.normal(0, 1, size=len(t))

fhr[100:120] += 18
fhr[300:320] += 20

threshold = baseline + 15
min_duration = 15

accelerations = []
in_event = False

for i in range(len(fhr)):

    if fhr[i] >= threshold and not in_event:
        start = i
        in_event = True

    elif fhr[i] < threshold and in_event:
        end = i

        if end - start >= min_duration:
            peak = np.max(fhr[start:end])
            accelerations.append((start, end, peak))

        in_event = False

plt.figure(figsize=(14,6))

plt.plot(t, fhr, color='blue', label='FHR Signal')

plt.axhline(baseline, color='red', linestyle='--', label='Baseline')

plt.axhline(threshold, color='green', linestyle='--',
            label='Threshold')

for s, e, p in accelerations:
    plt.axvspan(s, e, color='green', alpha=0.2)

    plt.text((s+e)/2,
             p+1,
             f'{e-s} s',
             ha='center',
             fontsize=12)

plt.xlabel('Time (seconds)')
plt.ylabel('FHR (bpm)')

plt.title('Fetal Heart Rate Acceleration Detection')

plt.legend()

plt.grid(True)

plt.show()

print('\nDetected Accelerations:\n')

for i, (s, e, p) in enumerate(accelerations):

    print(f'{i+1}: '
          f'Start={s}s  '
          f'End={e}s  '
          f'Duration={e-s}s  '
          f'Peak={int(p)} bpm  '
          f'Increase={int(p-baseline)} bpm')

print(f'\nTotal valid accelerations: {len(accelerations)}')

if len(accelerations) >= 2:
    print('Result: Reactive NST')
else:
    print('Result: Non-Reactive NST')